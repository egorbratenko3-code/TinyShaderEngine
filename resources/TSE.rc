// ==========================================================================
// TSE.rc - Windows resource script
// Embeds TSE.ico as the application icon for TSE.exe
// Place your icon file at: resources/TSE.ico  (32x32 + 16x16 + 256x256 multi-size .ico)
// ==========================================================================
#include <winuser.h>
#include "resource.h"

// IDI_TSE_ICON must be the FIRST/lowest-ID icon resource in the file to be
// picked up as the .exe's Explorer/taskbar icon by the MinGW linker.
IDI_TSE_ICON ICON "TSE.ico"

// ---- Version info (optional but recommended) ------------------------------
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TinyShaderEngine Project"
            VALUE "FileDescription",  "TinyShaderEngine - Realtime Vulkan Model Viewer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TSE"
            VALUE "OriginalFilename", "TSE.exe"
            VALUE "ProductName",      "TinyShaderEngine"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
